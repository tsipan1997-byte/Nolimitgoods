'use client';

import { useState } from 'react';
import { Search, CheckCircle2, Clock, AlertCircle } from 'lucide-react';

export default function PartsSearchWidget() {
  const [oem, setOem] = useState('');
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState<string | null>(null);

  const handleSearch = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!oem.trim()) return;

    setLoading(true);
    setError(null);
    setResult(null);

    try {
      const res = await fetch(`/api/parts/search?oem=${encodeURIComponent(oem)}`);
      const data = await res.json();

      if (!res.ok) throw new Error(data.error || 'Помилка пошуку');

      if (!data.found) {
        setError(data.message || 'Позицію не знайдено на складах UK');
      } else {
        setResult(data);
      }
    } catch (err: any) {
      setError(err.message || 'Сталася помилка з’єднання');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="w-full max-w-2xl mx-auto my-8 p-6 bg-white rounded-xl shadow-md border border-gray-100">
      <h2 className="text-xl font-bold text-gray-900 mb-2">
        Пошук запчастин за ОЕМ / Каталожним номером
      </h2>
      <p className="text-sm text-gray-500 mb-4">
        Пряма перевірка залишків на складах Великої Британії (Ковентрі)
      </p>

      <form onSubmit={handleSearch} className="flex gap-2 mb-6">
        <input
          type="text"
          value={oem}
          onChange={(e) => setOem(e.target.value)}
          placeholder="Наприклад: P553004, 458/20403..."
          className="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
        />
        <button
          type="submit"
          disabled={loading}
          className="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg flex items-center gap-2 transition-colors disabled:opacity-50"
        >
          <Search className="w-4 h-4" />
          {loading ? 'Пошук...' : 'Перевірити'}
        </button>
      </form>

      {error && (
        <div className="p-4 bg-amber-50 border border-amber-200 rounded-lg flex items-center gap-3 text-amber-800">
          <AlertCircle className="w-5 h-5 flex-shrink-0" />
          <span>{error}</span>
        </div>
      )}

      {result && (
        <div className="p-5 bg-gray-50 border border-gray-200 rounded-lg">
          <div className="flex justify-between items-start mb-2">
            <h3 className="font-semibold text-lg text-gray-900">{result.title}</h3>
            <span className="text-2xl font-bold text-blue-600">
              £{result.finalPriceGbp}
            </span>
          </div>

          <div className="space-y-2 mt-4 text-sm text-gray-600">
            <div className="flex items-center gap-2">
              <CheckCircle2 className="w-4 h-4 text-green-600" />
              <span>
                Хаб відвантаження: <strong>{result.hub}</strong>
              </span>
            </div>
            <div className="flex items-center gap-2">
              <Clock className="w-4 h-4 text-blue-600" />
              <span>Термін поставки: {result.deliveryTime}</span>
            </div>
          </div>

          <div className="mt-5 pt-4 border-t border-gray-200 flex justify-between items-center">
            <span className="text-xs text-gray-400 font-mono">
              OEM: {result.oem}
            </span>
            <button className="px-5 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md text-sm transition-colors">
              Замовити доставку
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
