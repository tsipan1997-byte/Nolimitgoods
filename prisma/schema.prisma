generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  service   String?
  message   String
  createdAt DateTime @default(now())
}

model RFQSubmission {
  id           String   @id @default(cuid())
  partNumber   String
  machineModel String?
  quantity     Int      @default(1)
  name         String
  email        String
  phone        String
  country      String?
  notes        String?
  createdAt    DateTime @default(now())
}

model CachedPart {
  id               String   @id @default(cuid())
  oem              String   @unique
  title            String
  supplierName     String
  supplierCountry  String
  supplierPriceGbp Float
  finalPriceGbp    Float
  hubLocation      String   @default("Coventry, UK / EU Transit")
  deliveryTransit  String   @default("5-8 робочих днів до України")
  inStock          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}
